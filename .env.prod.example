# Production Configuration Example
# Copy this file to '.env' in the same directory before building:
# cp .env.prod.example .env

# [OPTIONAL] Socket server URL.
# Under the Traefik setup, this is OPTIONAL and can be left empty.
# If left empty, the application will connect to the same domain where it is hosted (e.g. https://game.edservicetx.com).
# Configure this ONLY if you run the backend on a different domain or server.
# VITE_SOCKET_URL=https://api.someotherdomain.com
VITE_SOCKET_URL=
